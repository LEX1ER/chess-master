{
  "name": "Chess Master",
  "version": "1.0.0",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": ["*://*.chess.com/*"],
      "js": ["dist/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/stockfish-18-lite-single.js",
        "dist/stockfish-18-lite-single.wasm"
      ],
      "matches": ["*://*.chess.com/*"]
    }
  ]
}
